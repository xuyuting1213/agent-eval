# 复制为 .env 后按需修改。勿将真实密钥提交到 Git。

# PostgreSQL（与仓库内 docker-compose.yml 默认一致时，端口为 5433）
DATABASE_URL="postgresql://app_user:app_password@localhost:5433/app_db"

# 模型等（示例）
# ZHIPU_API_KEY=
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=

# APISpace 中国城市实况天气（与 eolink 天气 v001/now 一致；勿将 Token 提交到 Git）
# APISPACE_WEATHER_TOKEN=
# 可选，默认与示例接口一致
# APISPACE_WEATHER_URL=https://eolink.o.apispace.com/456456/weather/v001/now
